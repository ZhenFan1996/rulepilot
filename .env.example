# Copy to .env for local development. Do not commit .env or real credentials.
APP_ENV=local
BACKEND_PORT=8080
# The default dev command runs API and Worker in one process; dev-split and deployment-up use separate roles.
FRONTEND_PORT=5173
SPEECH_PROVIDER=fake
VIDEO_PROVIDER=manifest
EMBEDDING_PROVIDER=fake
TEACHING_PROVIDER=fake
TEACHING_MODEL_PROVIDER=gemini
# Optional independent vision role. With fake, a vision-capable teaching model is reused automatically.
VISUAL_PROVIDER=fake
VISUAL_MODEL_PROVIDER=gemini
# Visual enhancement is optional and never holds back the text lesson. Keep this short for remote VL providers.
VISUAL_MAX_SECTIONS=5
VISUAL_MAX_STEPS_PER_SECTION=2
VISUAL_COVERAGE_PROBE_PAGES=4
VISUAL_LOCATION_TIMEOUT=PT45S
# A complete icon inventory can require a long structured response from a large VL model.
VISUAL_CATALOG_TIMEOUT=PT120S
TEACHING_AGENT_MAX_TOOL_CALLS=24
ANSWER_PROVIDER=fake
ANSWER_MODEL_PROVIDER=gemini
CRITIC_PROVIDER=fake
CRITIC_MODEL_PROVIDER=gemini
CRITIC_EVALUATION_MODE=false
CRITIC_ATOMIC_CONFIRMATION_CONCURRENCY=4
# Optional developer harness. Point to a local file such as file:/path/to/cases.json.
ANSWER_REGRESSION_DATASET=
ANSWER_REGRESSION_NAME=external-answer-regressions

# Register an application at https://boardgamegeek.com/applications before using BGG search.
BGG_API_TOKEN=
# Optional comma-separated IP literals for a deployment whose DNS advertises unreachable BGG CDN nodes.
# HTTPS still uses BGG_BASE_URL as the hostname and certificate identity.
BGG_RESOLVED_ADDRESSES=
RULEBOOK_DISCOVERY_MODEL=qwen-plus
RULEBOOK_DISCOVERY_TIMEOUT=PT30S
# Comma-separated publisher domains that receive a verified badge in rulebook search results.
RULEBOOK_OFFICIAL_DOMAINS=
BGG_BASE_URL=https://boardgamegeek.com

# Enable only providers you intend to call. Keep real keys in .env only.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5-mini

GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Teaching, answers, and broad Critic discovery use this fast mode; atomic and objective Critic checks keep thinking.
DEEPSEEK_GENERATION_THINKING=false
BGG_TRANSLATION_ENABLED=false
BGG_TRANSLATION_TIMEOUT=PT20S
BGG_TRANSLATION_CACHE_TTL=P30D
BGG_TRANSLATION_HOURLY_LIMIT=60
BGG_TRANSLATION_PROVIDER_CONCURRENCY=2
BGG_RECOMMENDATION_AGENT_ENABLED=false
BGG_RECOMMENDATION_PROVIDER=fake
BGG_RECOMMENDATION_MODEL_PROVIDER=qwen
BGG_RECOMMENDATION_AGENT_CACHE_TTL=P1D
BGG_RECOMMENDATION_AGENT_HOURLY_LIMIT=240
BGG_RECOMMENDATION_AGENT_PROVIDER_CONCURRENCY=2
BGG_RECOMMENDATION_CANDIDATE_POOL_SIZE=20
BGG_RECOMMENDATION_RESULT_COUNT=3
BGG_RECOMMENDATION_DIVERSITY_OVERLAP_LIMIT=0.66
BGG_RECOMMENDATION_WEB_RESEARCH_ENABLED=false
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WEB_SEARCH_MODEL=qwen3.5-plus
RULEBOOK_DISCOVERY_ENABLED=false
# Official-rulebook discovery reuses WEB_SEARCH_* unless RULEBOOK_DISCOVERY_API_KEY,
# RULEBOOK_DISCOVERY_BASE_URL, or RULEBOOK_DISCOVERY_MODEL is explicitly set.
RULEBOOK_DISCOVERY_TIMEOUT=PT30S
RULEBOOK_OFFICIAL_DOMAINS=
BGG_RECOMMENDATION_WEB_RESEARCH_TIMEOUT=PT25S
BGG_RECOMMENDATION_WEB_RESEARCH_CACHE_TTL=P7D
BGG_RECOMMENDATION_WEB_RESEARCH_HOURLY_LIMIT=60
BGG_RECOMMENDATION_WEB_RESEARCH_PROVIDER_CONCURRENCY=2
BGG_CACHE_HOT_FRESH_TTL=PT1H
BGG_CACHE_HOT_STALE_TTL=P1D
BGG_CACHE_DETAIL_FRESH_TTL=P7D
BGG_CACHE_DETAIL_STALE_TTL=P30D
BGG_CACHE_MAXIMUM_ENTRY_BYTES=262144
BGG_CACHE_MAXIMUM_ENTRIES=10000
BGG_CACHE_MAXIMUM_BYTES=67108864
BGG_CACHE_CLEANUP_DELAY=PT1H
MODEL_REQUEST_TIMEOUT=PT2M

# Qwen VL uses DashScope's OpenAI-compatible multimodal endpoint. Replace the URL for your region/workspace if needed.
QWEN_ENABLED=false
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-plus
# Text retrieval uses a dedicated embedding model rather than the configured chat/vision model.
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1024
QWEN_EMBEDDING_REQUEST_TIMEOUT=PT30S
QWEN_EMBEDDING_BATCH_SIZE=10
# Set false when the configured Qwen model accepts text only.
QWEN_VISION_CAPABLE=true
# Official-rulebook discovery uses a fast web-search-capable text model independently of vision and recommendation.
RULEBOOK_DISCOVERY_MODEL=qwen-plus
RULEBOOK_DISCOVERY_TIMEOUT=PT30S
RULEBOOK_DISCOVERY_CACHE_TTL=P30D
# Qwen commonly allows one concurrent multimodal request. Raise only after checking the selected provider account.
VISUAL_REQUEST_PARALLELISM=1

# Any service exposing an OpenAI-compatible Chat Completions API.
COMPATIBLE_MODEL_ENABLED=false
COMPATIBLE_MODEL_API_KEY=
COMPATIBLE_MODEL_BASE_URL=http://localhost:11434/v1
COMPATIBLE_MODEL_NAME=local-model
COMPATIBLE_MODEL_VISION_CAPABLE=false
AGENT_MAX_STEPS=40
AGENT_MAX_TOOL_CALLS=24
AGENT_MAX_MODEL_CALLS=16
AGENT_MAX_TOKENS=24000
AGENT_TIMEOUT=PT2M
TEACHING_AGENT_MAX_TOOL_CALLS=72
# One composition, one post-publication review, and at most one targeted correction per chapter.
TEACHING_AGENT_MAX_MODEL_CALLS=36
TEACHING_AGENT_MAX_TOKENS=300000
TEACHING_AGENT_TIMEOUT=PT10M
TEACHING_BACKGROUND_CORE_POOL_SIZE=2
TEACHING_BACKGROUND_MAX_POOL_SIZE=4
TEACHING_BACKGROUND_QUEUE_CAPACITY=20
ANSWER_CACHE_RETENTION=PT6H
ANSWER_CACHE_RETENTION_JITTER=PT1H
ANSWER_RATE_USER_REQUESTS=20
ANSWER_RATE_USER_WINDOW=PT1M
ANSWER_RATE_SESSION_CONCURRENCY=1
ANSWER_RATE_PROVIDER_CONCURRENCY=8
ANSWER_RATE_LEASE=PT30S
TRACING_SAMPLING_PROBABILITY=1.0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Local identities only. Replace these values in .env.
RULEPILOT_USER_USERNAME=player
RULEPILOT_USER_PASSWORD=change-me-local-only
RULEPILOT_ADMIN_USERNAME=admin
RULEPILOT_ADMIN_PASSWORD=change-me-local-only
SESSION_COOKIE_SECURE=false

# PostgreSQL (used from P0-04 onward)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rulepilot
POSTGRES_USER=rulepilot
POSTGRES_PASSWORD=change-me-local-only

# Redis (used from P1/P5 onward)
REDIS_HOST=localhost
REDIS_PORT=6379
GAME_SESSION_CONTEXT_RETENTION=PT12H

# RabbitMQ (used from P0-04/P9 onward)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=rulepilot
RABBITMQ_PASSWORD=change-me-local-only
DOCUMENT_PROCESSING_EXCHANGE=rulepilot.document.processing
DOCUMENT_PROCESSING_QUEUE=rulepilot.document.processing.v1
DOCUMENT_PROCESSING_ROUTING_KEY=document.processing.requested.v1
DOCUMENT_PROCESSING_RETRY_EXCHANGE=rulepilot.document.processing.retry
DOCUMENT_PROCESSING_DLX=rulepilot.document.processing.dlx
DOCUMENT_PROCESSING_DLQ=rulepilot.document.processing.dlq.v1
DOCUMENT_PROCESSING_MAX_ATTEMPTS=4
DOCUMENT_PROCESSING_RETRY_DELAYS=1s,5s,20s
DOCUMENT_PROCESSING_METRICS_FIXED_DELAY=5s
OUTBOX_PUBLISH_BATCH_SIZE=20
OUTBOX_PUBLISH_FIXED_DELAY=2s
OUTBOX_PUBLISH_CONFIRM_TIMEOUT=5s

# MinIO (used from P0-04/P2 onward)
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=rulepilot
MINIO_SECRET_KEY=change-me-local-only
MINIO_BUCKET=rulepilot-documents
MAX_PDF_BYTES=52428800
MAX_PDF_PAGES=500
MAX_PDF_EXTRACTED_CHARACTERS=5000000
MAX_PDF_UPLOAD_SIZE=50MB

# Local observability
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
OTEL_HTTP_PORT=4318
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only
