{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{application=\"rulepilot\"}[5m]))", "legendFormat": "requests"}],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"rulepilot\"}[5m])))", "legendFormat": "p95"}],
      "title": "HTTP p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "sum(jvm_memory_used_bytes{application=\"rulepilot\",area=\"heap\"}) / sum(jvm_memory_max_bytes{application=\"rulepilot\",area=\"heap\"})", "legendFormat": "heap"}],
      "title": "JVM heap usage",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum by (result) (rate(rulepilot_answer_cache_requests_total[5m]))", "legendFormat": "{{result}}"}],
      "title": "Answer cache outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "id": 5,
      "targets": [{"expr": "sum by (stage) (rate(rulepilot_document_processing_stage_duration_seconds_count[5m]))", "legendFormat": "{{stage}}"}],
      "title": "Document processing stages",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 42,
  "tags": ["rulepilot"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "browser",
  "title": "RulePilot Overview",
  "uid": "rulepilot-overview",
  "version": 1
}
