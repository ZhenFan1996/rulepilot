rulepilot.cn, www.rulepilot.cn {
    # Caddy 2.10 prefers the new hybrid post-quantum group. Older LibreSSL clients and the
    # production verification runner have both reset that handshake before HTTP begins, so keep
    # the public edge on the broadly interoperable modern groups until those clients catch up.
    tls {
        curves x25519 secp256r1
    }
    encode zstd gzip
    reverse_proxy frontend:80
}
