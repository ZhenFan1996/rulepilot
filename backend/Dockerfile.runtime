FROM eclipse-temurin:21-jre-jammy

RUN apt-get update \
    && apt-get install --no-install-recommends --yes poppler-utils python3 \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system rulepilot \
    && useradd --system --gid rulepilot --home-dir /app rulepilot
WORKDIR /app
COPY --chown=rulepilot:rulepilot target/rulepilot-backend-*.jar app.jar
USER rulepilot
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
