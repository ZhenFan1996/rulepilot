FROM eclipse-temurin:21-jre-jammy

RUN apt-get update \
    && apt-get install --no-install-recommends --yes poppler-utils python3-opencv \
    && rm -rf /var/lib/apt/lists/*
COPY src/main/resources/visual/opencv-region-proposals.py /tmp/opencv-region-proposals.py
COPY src/test/visual/opencv-region-proposals-smoke.py /tmp/opencv-region-proposals-smoke.py
RUN python3 -B /tmp/opencv-region-proposals-smoke.py /tmp/opencv-region-proposals.py \
    && rm /tmp/opencv-region-proposals-smoke.py /tmp/opencv-region-proposals.py \
    && groupadd --system rulepilot \
    && useradd --system --gid rulepilot --home-dir /app rulepilot
WORKDIR /app
COPY --chown=rulepilot:rulepilot target/rulepilot-backend-*.jar app.jar
USER rulepilot
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
